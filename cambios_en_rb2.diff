+# Goal: decision TIPADA del interprete_ordenes. La prioridad la fija el MODELO.
+string client_id
+uint8 priority            # 0 = mas alta ... 2 = mas baja (igual que MoveJoints)
+string accion             # recoger_y_colocar | ir_inicio | desconocida
+string objeto
+string color
+string zona
+string frase
+bool permitido
+string causa_decision     # por que no es permitida (si permitido == false)
+bool degradado
+string fuente             # laya | palabras_clave
+# Marcas de tiempo / etapas previas (Parte C del examen)
+float64 t_fin_habla       # epoch s; 0.0 si la orden fue escrita
+float64 captura_ms
+float64 transcripcion_ms
+float64 decision_ms
+---
+# Result
+bool success
+string message
+float64[] final_q
+float64 error_fk_mm       # |FK(q alcanzado) - posicion solicitada| en el deposito
+float64 voz_a_movimiento_ms
+---
+# Feedback
+uint32 queue_position    # 0 = ejecutandose
+string state             # QUEUED | PERCEIVING | PLANNING | EXECUTING | GRIPPER
+float64 progress
